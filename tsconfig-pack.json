{
  "compilerOptions": {
    "allowJs": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "lib": [
      "dom",
      "es2017"
    ],
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "module": "esnext",
    "target": "es5",
    "noImplicitAny": false,
    "sourceMap": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "src/editor/**/*",
    "src/ai/**/*",
    "src/markdown/**/*",
    "src/type.ts",
    "src/core/**/*",
    "src/icons/**/*",
    "src/icons.ts",
    "src/defaults/**/*",
    "src/default-icons/**/*",
    "src/brands/**/*"
  ]
}
