{
  "name": "@zrlog/editor",
  "version": "2.2.0",
  "description": "ZrLog Markdown editor for React with a standalone Markdown renderer",
  "homepage": "./",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zrlog/zrlog-editor.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@ant-design/icons": "6.2.3",
    "@codemirror/lang-markdown": "6.3.3",
    "@codemirror/lang-yaml": "6.1.2",
    "@codemirror/language-data": "6.5.1",
    "@uiw/react-codemirror": "4.24.1",
    "axios": "1.12.0",
    "flowchart.js": "1.18.0",
    "highlight.js": "11.11.1",
    "katex": "0.16.22",
    "marked": "16.0.0",
    "react-sequence-diagram": "0.0.12"
  },
  "peerDependencies": {
    "antd": "6.4.x",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.1.15"
  },
  "resolutions": {
    "@rc-component/util": "1.11.1"
  },
  "scripts": {
    "lint": "yarn type-check",
    "start": "export PORT=3030 && craco start",
    "type-check": "tsc --project tsconfig.json --pretty --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc --project tsconfig-pack.json && npm run build:markdown && node shell/build-entries.cjs",
    "build:markdown": "tsc --project tsconfig-markdown.json && node shell/build-markdown.cjs",
    "test:markdown": "npm run build:markdown && node --test tests/markdown.test.cjs",
    "pages": "craco build",
    "test": "npm run type-check && npm run build && node --test tests/*.test.cjs",
    "pack": "mkdir -p .tmp/packages && npm pack --ignore-scripts --pack-destination .tmp/packages",
    "prepack": "npm run build",
    "version": "node shell/sync-version.cjs"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@craco/craco": "7.1.0",
    "@types/katex": "0.16.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/react-router": "5.1.20",
    "@types/react-router-dom": "5.3.3",
    "@typescript-eslint/typescript-estree": "8.38.0",
    "cross-env": "7.0.3",
    "husky": "7.0.4",
    "jsdom": "16.7.0",
    "lint-staged": "11.1.2",
    "antd": "6.4.3",
    "prettier": "2.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "6.30.3",
    "react-router-dom": "6.30.3",
    "react-scripts": "5.0.1",
    "styled-components": "6.1.15",
    "typescript": "5.8.3",
    "webpack": "5.100.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.tsx": [
      "prettier --write",
      "eslint --fix --max-warnings=0",
      "git add"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json",
    "editor-changelog.md",
    "markdown.js",
    "markdown.d.ts",
    "icons.js",
    "icons.d.ts",
    "core.js",
    "core.d.ts",
    "core",
    "brands",
    "default-icons",
    "docs/theme-icons.md"
  ],
  "main": "dist/editor/marked-editor.js",
  "module": "dist/editor/marked-editor.js",
  "types": "dist/editor/marked-editor.d.ts",
  "exports": {
    ".": {
      "types": "./dist/editor/marked-editor.d.ts",
      "default": "./dist/editor/marked-editor.js"
    },
    "./markdown": {
      "types": "./markdown.d.ts",
      "default": "./markdown.js"
    },
    "./*": "./*",
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/cjs/icons.js",
      "default": "./dist/icons.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/cjs/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js",
      "require": "./dist/cjs/core/*.js",
      "default": "./dist/core/*.js"
    },
    "./brands/*": {
      "types": "./dist/brands/*.d.ts",
      "import": "./dist/brands/*.js",
      "require": "./dist/cjs/brands/*.js",
      "default": "./dist/brands/*.js"
    },
    "./default-icons/*": {
      "types": "./dist/default-icons/*.d.ts",
      "import": "./dist/default-icons/*.js",
      "require": "./dist/cjs/default-icons/*.js",
      "default": "./dist/default-icons/*.js"
    }
  }
}
